{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Walkthrough episode spec",
  "description": "Machine-readable form of one walkthroughs/NN-*.md recording script.",
  "type": "object",
  "required": ["id", "slug", "title", "segments"],
  "properties": {
    "id":    { "type": "string", "pattern": "^[0-9]{2}$" },
    "slug":  { "type": "string" },
    "title": { "type": "string" },
    "sourceFile": { "type": "string" },
    "targetRuntimeSec": { "type": ["number", "null"] },
    "gate": { "type": ["string", "null"] },
    "workflowPath": {
      "type": ["string", "null"],
      "description": "Repo-relative workflow JSON the episode reads, from a **Workflow:** line."
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["heading", "beats"],
        "properties": {
          "heading": { "type": "string" },
          "atSec": { "type": ["number", "null"], "description": "Timecode from the '## Heading — M:SS' line." },
          "beats": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind"],
              "properties": {
                "kind": { "enum": ["screen", "say", "action", "hold", "callout"] },
                "text": { "type": "string" },
                "code": {
                  "type": "array", "items": { "type": "string" },
                  "description": "Fenced blocks attached to this beat — text to type or paste on camera."
                },
                "estSec": {
                  "type": "number",
                  "description": "say: narration duration at 150wpm. hold: the explicit seconds. others: dwell time."
                }
              }
            }
          }
        }
      }
    }
  }
}
