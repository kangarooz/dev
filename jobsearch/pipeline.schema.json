{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Job application pipeline state",
  "type": "object",
  "required": [
    "version",
    "last_scan_utc",
    "target_comp",
    "opportunities"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "last_scan_utc": {
      "type": "string",
      "description": "ISO timestamp of the last completed scan; next run searches newer_than this"
    },
    "target_comp": {
      "type": "object",
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "basis": {
          "enum": [
            "base",
            "total_comp",
            "unconfirmed"
          ]
        },
        "reservation_min": {
          "type": "number",
          "description": "stated reservation comp (alert gate); alerts create records only when band top >= this"
        },
        "reservation_basis": {
          "type": "string"
        },
        "current": {
          "type": "number",
          "description": "comp at current employer; the effective floor"
        }
      }
    },
    "opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "company",
          "role",
          "stage",
          "last_activity_date"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "slug: company-role, stable across runs"
          },
          "company": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "stage": {
            "enum": [
              "prospect",
              "applied",
              "recruiter_outreach",
              "interview_requested",
              "interviewing",
              "offer",
              "accepted",
              "rejected",
              "withdrawn",
              "stale"
            ]
          },
          "in_band": {
            "enum": [
              "yes",
              "no",
              "unknown",
              "below_reservation"
            ],
            "description": "does known comp clear target_comp?"
          },
          "salary": {
            "type": "object",
            "properties": {
              "stated": {
                "type": "string",
                "description": "verbatim numbers with attribution and date"
              },
              "asked": {
                "type": "boolean",
                "description": "has Nick asked for the range yet?"
              }
            }
          },
          "contacts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "channel": {
                  "enum": [
                    "gmail",
                    "outlook",
                    "linkedin"
                  ]
                }
              }
            }
          },
          "thread_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Gmail thread ids"
          },
          "last_activity_date": {
            "type": "string"
          },
          "last_direction": {
            "enum": [
              "inbound",
              "outbound"
            ]
          },
          "meetings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "when": {
                  "type": "string"
                },
                "what": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "proposed",
                    "scheduled",
                    "done",
                    "cancelled"
                  ]
                }
              }
            }
          },
          "deadline": {
            "type": "string",
            "description": "availability window, offer expiry, etc."
          },
          "action_needed": {
            "type": "string",
            "description": "what Nick must do next; empty when ball is in their court"
          },
          "history": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "append-only one-liners: date - event"
          },
          "source": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "action_since": {
            "type": "string",
            "description": "date action_needed was last set or changed; drives digest escalation and the 48h push rule (legacy fallback: last_activity_date)"
          },
          "company_domain": {
            "type": "string"
          },
          "applied_utc": {
            "type": "string"
          },
          "last_human_direction": {
            "enum": [
              "inbound",
              "outbound"
            ],
            "description": "only human messages update this; ATS auto-acks do not"
          }
        }
      }
    },
    "closed_index": {
      "type": "array",
      "description": "Terminal (rejected/stale/withdrawn) records kept compact for dedup: id, company, role, stage, last_activity_date, up to 2 thread_ids.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "company",
          "stage",
          "last_activity_date"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": " May carry a #reason suffix (e.g. #sci, #below-band)."
          },
          "company": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "stage": {
            "enum": [
              "rejected",
              "stale",
              "withdrawn",
              "below_band",
              "disqualified"
            ]
          },
          "last_activity_date": {
            "type": "string"
          },
          "thread_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 2
          },
          "contacts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "contact emails only (revival substrate)"
          },
          "salary_stated": {
            "type": "string"
          }
        }
      }
    },
    "journal_seq": {
      "type": "integer",
      "description": "highest delta seq folded into this base"
    },
    "last_compact_utc": {
      "type": "string"
    },
    "pending_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "asked": {
            "type": "string"
          },
          "question": {
            "type": "string"
          }
        }
      }
    },
    "spray_senders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "first_seen": {
            "type": "string"
          },
          "band_seen": {
            "type": "string"
          }
        }
      },
      "description": "generic shape; populated list lives only in the private draft"
    },
    "current_role": {
      "type": "object",
      "description": "current employer record, excluded from all scans",
      "properties": {
        "company": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "comp": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "thread_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "candidate_constraints": {
      "type": "object"
    }
  },
  "description": "Job application pipeline state (v2). Empty/default fields are omitted on serialization; absent means empty. Stale and disqualified are the only permitted stage demotions (see runbook.md); interview_requested and later are never auto-demoted."
}