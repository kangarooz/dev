# pipeline outputs
demo-output/
/out/
/out-*/
/tmp-*/
chrome-profile*/

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv*/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# generated media and test scratch (never commit recordings)
*.mp4
*.mkv
*.wav
raw/frames/
tests/**/out/
tests/**/tmp/

# credentials (creds set) and recorded reference voices (record-ref)
.env
.env.*
!.env.example
voices/*.wav
voices/*.json
!voices/.gitkeep

# bench runs (python -m demo_smoke bench --out bench/...): runs/, meta/, report.md, bench.json.
# The example baseline (and a hand-written bench/baseline.json) stay tracked.
bench/*
!bench/baseline.example.json
!bench/baseline.json
