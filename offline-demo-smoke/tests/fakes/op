#!/bin/sh
# Fake 1Password CLI for the tests (POSIX).  Put tests/fakes first on PATH.
#   op --version              -> 2.30.0-fake
#   op read op://vault/item/f -> "resolved:op://vault/item/f"
#   FAKE_OP_FAIL=msg          -> every read fails with that message (exit 1)
# Anything else is an error, like the real CLI would complain.
case "$1" in
  --version) echo "2.30.0-fake"; exit 0 ;;
  read) ;;
  *) echo "[ERROR] fake op: unsupported command: $*" 1>&2; exit 1 ;;
esac
shift
ref=""
for a in "$@"; do
  case "$a" in
    -*) ;;
    *) ref="$a" ;;
  esac
done
if [ -n "$FAKE_OP_FAIL" ]; then
  echo "[ERROR] fake op: $FAKE_OP_FAIL" 1>&2
  exit 1
fi
case "$ref" in
  op://*) ;;
  *) echo "[ERROR] fake op: not an op:// reference: '$ref'" 1>&2; exit 1 ;;
esac
printf 'resolved:%s\n' "$ref"
